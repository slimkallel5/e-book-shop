# ==========================================
# E-BookShop Tunisia Environment Configuration
# ==========================================

# Application Mode
# 'development' or 'production'
NODE_ENV=development

# API Server Port
# Default: 3000
PORT=3000

# Storage Selection Mode
# Options: 'json' (offline local development/testing) or 'postgres' (persistent database)
DATA_STORE=json

# PostgreSQL Database Connection String
# Required when DATA_STORE=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ebookshop?schema=public"

# Admin Authentication JWT Secrets
# Replace JWT_SECRET with a strong random string in production
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1d

# Google reCAPTCHA Verification
# Set RECAPTCHA_ENABLED=true in production to require valid Google reCAPTCHA tokens on checkout
RECAPTCHA_SECRET_KEY=dev-recaptcha-secret-key
RECAPTCHA_ENABLED=false

# Media & Upload Storage Directory
# Directory relative to root or absolute path where posters and sample PDFs are saved
UPLOAD_DIR=uploads

# OpenAPI / Swagger Documentation Path
# Once running, Swagger UI is available at: http://localhost:3000/api/docs
